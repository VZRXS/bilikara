diff --git a/test/browse-pagination.spec.ts b/test/browse-pagination.spec.ts
new file mode 100644
--- /dev/null
+++ b/test/browse-pagination.spec.ts
@@ -0,0 +1,39 @@
+import { createExecutionContext, env } from "cloudflare:test";
+import { beforeEach, expect, it } from "vitest";
+import worker from "../src/index";
+import { createProjectionSchema } from "./helpers/browse-schema";
+
+beforeEach(async () => {
+  await createProjectionSchema();
+  await env.bilikara_db.prepare("INSERT INTO browse_terms(kind,display_name,normalized_name,locale) VALUES('name','作品','作品','ja'),('name','作品','作品','zh'),('artist','歌手','歌手','ja')").run();
+  await env.bilikara_db.prepare("INSERT INTO browse_term_aliases(term_id,alias_name,normalized_alias) VALUES(1,'Alias','alias'),(2,'Alias','alias'),(3,'Singer','singer')").run();
+  const rows=Array.from({length:221},(_,n)=>({bvid:`BV${String(n).padStart(10,"0")}`,title:`Song ${n}`}));
+  await env.bilikara_db.prepare("INSERT INTO videos(bvid,title) SELECT json_extract(value,'$.bvid'),json_extract(value,'$.title') FROM json_each(?)").bind(JSON.stringify(rows)).run();
+  await env.bilikara_db.prepare("INSERT INTO browse_term_videos(term_id,bvid,source_field) SELECT term_id,bvid,'tag_1' FROM browse_terms CROSS JOIN videos").run();
+});
+async function browse(params:string) {
+  const response=await worker.fetch(new Request(`https://local.test/browse?${params}`),env,createExecutionContext());
+  expect(response.status).toBe(200);
+  return response.json() as Promise<any>;
+}
+it.each([['name','Alias'],['artist','Singer']])('pages %s aliases without duplicate videos or a full count',async(kind,tag)=>{
+  const all:string[]=[];
+  for(const offset of [0,100,200]) {
+    const page=await browse(`kind=${kind}&tag=${tag}&offset=${offset}&limit=100`);
+    expect(page.items).toHaveLength(Math.min(100,221-offset));
+    expect(page.has_more).toBe(offset<200);
+    expect(page.next_offset).toBe(Math.min(offset+100,221));
+    all.push(...page.items.map((item:any)=>item.bvid));
+  }
+  expect(new Set(all).size).toBe(221);
+  expect(all).toEqual(Array.from({length:221},(_,n)=>`BV${String(n).padStart(10,"0")}`));
+  expect((await browse(`kind=${kind}&tag=${tag}&offset=221&limit=100`)).items).toEqual([]);
+});
+it('keeps legacy clients, filtered pages and invalid offsets bounded',async()=>{
+  expect((await browse('tag=Alias&limit=450')).items).toHaveLength(221);
+  expect((await browse('tag=Alias&q=Song%20220&limit=100')).items).toHaveLength(1);
+  for(const offset of ['-1','NaN','1.5','Infinity','100001']) {
+    const response=await worker.fetch(new Request(`https://local.test/browse?tag=Alias&offset=${offset}`),env,createExecutionContext());
+    expect(response.status).toBe(400);
+  }
+});
