@@ -0,0 +1,137 @@
+import { createExecutionContext, env } from "cloudflare:test";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import worker from "../src/index";
+import { createProjectionSchema } from "./helpers/browse-schema";
+
+const db = env.bilikara_db;
+const first = "BV0000000001", second = "BV0000000002";
+async function post(path: string, body: object = {}, authorized = true) {
+  return worker.fetch(new Request(`https://offline.test${path}?sync_google=0`, {
+    method: "POST", headers: { "Content-Type": "application/json" },
+    body: JSON.stringify({ ...body, ...(authorized ? { BILIKARA_ADMIN_SECRET: "offline" } : {}) }),
+  }), { ...env, BILIKARA_ADMIN_SECRET: "offline" }, createExecutionContext());
+}
+async function schema() {
+  await createProjectionSchema();
+  await db.prepare(`CREATE TABLE video_blacklist (
+    bvid TEXT PRIMARY KEY, active INTEGER, title TEXT, url TEXT, mid TEXT, owner_name TEXT,
+    owner_url TEXT, cover_url TEXT, reason_code TEXT, note TEXT, source TEXT, rejected_at INTEGER,
+    rejected_by TEXT, restored_at INTEGER, restored_by TEXT, record_json TEXT, updated_at INTEGER)`).run();
+}
+async function seed() {
+  await db.prepare("INSERT INTO videos(bvid,title,mid,tag_1,tag_status,preserved_3) VALUES(?,'First','42','kept tags',1,0),(?,'Second','43','kept tags',1,0)").bind(first, second).run();
+  await db.prepare("INSERT INTO browse_terms(term_id,kind,display_name,normalized_name) VALUES(1,'name','shared','shared'),(2,'name','unique','unique'),(3,'name','unrelated orphan','unrelated orphan')").run();
+  await db.prepare("INSERT INTO browse_term_aliases(term_id,alias_name,normalized_alias) SELECT term_id,display_name,normalized_name FROM browse_terms").run();
+  await db.prepare("INSERT INTO browse_term_videos(term_id,bvid,source_field) VALUES(1,?,'tag_1'),(1,?,'tag_1'),(2,?,'tag_1')").bind(first, second, first).run();
+}
+function meter() {
+  const rows: { sql: string; read: number; write: number }[] = [];
+  const sqls = new WeakMap<D1PreparedStatement, string>();
+  const prepare = db.prepare.bind(db), batch = db.batch.bind(db);
+  const record = (sql: string, result: D1Result) => rows.push({ sql, read: result.meta.rows_read, write: result.meta.rows_written });
+  const wrap = (s: D1PreparedStatement, sql: string): D1PreparedStatement => {
+    sqls.set(s, sql);
+    const bind = s.bind.bind(s), all = s.all.bind(s);
+    vi.spyOn(s, "bind").mockImplementation((...values) => wrap(bind(...values), sql));
+    vi.spyOn(s, "all").mockImplementation(async () => { const r = await all(); record(sql, r); return r; });
+    vi.spyOn(s, "run").mockImplementation(async () => { const r = await all(); record(sql, r); return r; });
+    vi.spyOn(s, "first").mockImplementation(async (column?: string) => {
+      const r = await all(); record(sql, r); const row = r.results[0] ?? null;
+      return column && row ? row[column] : row;
+    });
+    return s;
+  };
+  vi.spyOn(db, "prepare").mockImplementation(sql => wrap(prepare(sql), sql));
+  vi.spyOn(db, "batch").mockImplementation(async statements => {
+    const results = await batch(statements);
+    results.forEach((r, i) => record(sqls.get(statements[i])!, r));
+    return results;
+  });
+  return () => {
+    const current = rows.splice(0);
+    return { sql: current.length, read: current.reduce((n, r) => n + r.read, 0), write: current.reduce((n, r) => n + r.write, 0), queries: current };
+  };
+}
+afterEach(() => vi.restoreAllMocks());
+
+describe("bounded administration and review", () => {
+  beforeEach(async () => { await schema(); await seed(); });
+  it.each(["/admin/review/reject", "/admin/delete-video", "/delete-invalid", "/admin/reset-tags", "/admin/delete-mid"])("%s cleans only affected orphan terms, including FK cascades", async path => {
+    // A stale zero counter must not destroy a still-linked shared term.
+    await db.prepare("UPDATE browse_terms SET video_count=0 WHERE term_id=1").run();
+    const response = await post(path, { bvid: first, mid: "42" });
+    expect(response.status).toBe(200);
+    expect((await response.json() as any).success).toBe(true);
+    expect((await db.prepare("SELECT term_id FROM browse_terms ORDER BY term_id").all()).results).toEqual([{ term_id: 1 }, { term_id: 3 }]);
+    expect((await db.prepare("SELECT term_id FROM browse_term_aliases ORDER BY term_id").all()).results).toEqual([{ term_id: 1 }, { term_id: 3 }]);
+    expect((await db.prepare("SELECT term_id,bvid FROM browse_term_videos").all()).results).toEqual([{ term_id: 1, bvid: second }]);
+    expect(await db.prepare("SELECT count(*) AS n FROM videos WHERE bvid=?").bind(first).first("n")).toBe(path === "/admin/reset-tags" ? 1 : 0);
+  });
+  it("rolls back the blacklist, video and links if targeted cleanup fails", async () => {
+    await db.prepare("CREATE TRIGGER fail_cleanup BEFORE DELETE ON browse_terms BEGIN SELECT RAISE(ABORT,'offline failure'); END").run();
+    expect((await post("/admin/review/reject", { bvid: first })).status).toBe(500);
+    expect(await db.prepare("SELECT count(*) AS n FROM videos").first("n")).toBe(2);
+    expect(await db.prepare("SELECT count(*) AS n FROM video_blacklist").first("n")).toBe(0);
+    expect(await db.prepare("SELECT count(*) AS n FROM browse_term_videos").first("n")).toBe(3);
+  });
+  it("updates only the approval flag and is idempotent, without deleting or rewriting projections", async () => {
+    await db.prepare("CREATE TRIGGER forbid_delete BEFORE DELETE ON videos BEGIN SELECT RAISE(ABORT,'must not delete'); END").run();
+    await db.prepare("CREATE TRIGGER forbid_tags BEFORE UPDATE OF tag_1,title ON videos BEGIN SELECT RAISE(ABORT,'must not rewrite metadata'); END").run();
+    const response = await post("/admin/review/approve", { bvids: [first, first, "BV0000000999"] });
+    expect(response.status).toBe(200);
+    expect(await response.json()).toEqual({ success: true, approved_bvids: [first], updated: 1 });
+    const retry = await post("/admin/review/approve", { bvids: [first] });
+    expect(await retry.json()).toEqual({ success: true, approved_bvids: [first], updated: 0 });
+    expect(await db.prepare("SELECT preserved_3 FROM videos WHERE bvid=?").bind(first).first("preserved_3")).toBe(1);
+    expect(await db.prepare("SELECT preserved_3 FROM videos WHERE bvid=?").bind(second).first("preserved_3")).toBe(0);
+    expect(await db.prepare("SELECT count(*) AS n FROM video_blacklist").first("n")).toBe(0);
+    expect(await db.prepare("SELECT count(*) AS n FROM browse_term_videos").first("n")).toBe(3);
+    expect(await db.prepare("SELECT count(*) AS n FROM videos_fts").first("n")).toBe(2);
+  });
+  it("requires authentication before reading D1, and bounds records/approval to one page", async () => {
+    const take = meter();
+    for (const path of ["snapshot", "records", "approve"]) expect((await post(`/admin/review/${path}`, {}, false)).status).toBe(401);
+    for (const list of [[], Array(21).fill(first), ["bad"]]) expect((await post("/admin/review/approve", { bvids: list })).status).toBe(400);
+    expect((await post("/admin/review/records", { keys: Array(21).fill(first) })).status).toBe(400);
+    expect(take().sql).toBe(0);
+    const snapshot = await post("/admin/review/snapshot");
+    expect(snapshot.headers.get("Cache-Control")).toBe("private, no-store");
+    const data = await snapshot.json() as any;
+    expect(data.data).toHaveLength(2);
+    expect(Object.keys(data.data[0]).sort()).toEqual(["bvid", "preserved_3", "title", "url"]);
+    const records = await post("/admin/review/records", { keys: [second] });
+    expect((await records.json() as any).data.map((r: any) => r.bvid)).toEqual([second]);
+  });
+});
+
+it("measures old and new read/write costs locally at production-like scale", async () => {
+  await schema(); await seed();
+  await db.prepare(`WITH RECURSIVE seq(n) AS (VALUES(3) UNION ALL SELECT n+1 FROM seq WHERE n<49682)
+    INSERT INTO videos(bvid,title,preserved_3) SELECT 'BV'||printf('%010d',n),'Song '||n,0 FROM seq`).run();
+  await db.prepare(`WITH RECURSIVE seq(n) AS (VALUES(4) UNION ALL SELECT n+1 FROM seq WHERE n<35533)
+    INSERT INTO browse_terms(term_id,kind,display_name,normalized_name) SELECT n,'name','Group'||n,'group'||n FROM seq`).run();
+  await db.prepare("INSERT INTO browse_term_videos(term_id,bvid,source_field) SELECT term_id,?,'tag_1' FROM browse_terms WHERE term_id>=4").bind(second).run();
+  const take = meter();
+  // Exact former SQL, executed once; this removes only the unrelated orphan.
+  await db.prepare("DELETE FROM browse_terms WHERE video_count <= 0 OR NOT EXISTS (SELECT 1 FROM browse_term_videos WHERE browse_term_videos.term_id = browse_terms.term_id)").run();
+  const oldCleanup = take();
+  // The old export advances OFFSET by 5,000 until the final partial page.
+  for (let offset = 0; offset < 49682; offset += 5000) await db.prepare("SELECT bvid,title FROM videos ORDER BY rowid ASC LIMIT ? OFFSET ?").bind(5000, offset).all();
+  const oldExport = take();
+  expect((await post("/admin/review/reject", { bvid: first })).status).toBe(200);
+  const reject = take();
+  expect((await post("/admin/review/snapshot")).status).toBe(200);
+  const snapshot = take();
+  const keys = Array.from({ length: 20 }, (_, n) => "BV" + String(n + 2).padStart(10, "0"));
+  expect((await post("/admin/review/records", { keys })).status).toBe(200);
+  const page = take();
+  expect((await post("/admin/review/approve", { bvids: keys })).status).toBe(200);
+  const approval = take();
+  console.log(JSON.stringify({ test: "review-quota-cost", videos: 49682, terms: 35533, oldCleanup, oldExport, reject, snapshot, page, approval }));
+  expect(oldCleanup.read).toBeGreaterThan(35000);
+  expect(oldExport.read).toBeGreaterThan(270000);
+  expect(reject.read).toBeLessThan(500);
+  expect(snapshot.read + page.read).toBeLessThan(51000);
+  expect(approval.read).toBeLessThan(200);
+  expect(approval.write).toBeLessThan(100);
+}, 30_000);
