{
  "$schema": "../gen/schemas/remote-schema.json",
  "identifier": "stage",
  "description": "Allow the local Bilikara stage page to fullscreen its own native window.",
  "windows": [
    "stage"
  ],
  "remote": {
    "urls": [
      "http://127.0.0.1:*/*",
      "http://localhost:*/*"
    ]
  },
  "permissions": [
    "allow-set-window-fullscreen"
  ]
}
