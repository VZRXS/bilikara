{
  "$schema": "../gen/schemas/remote-schema.json",
  "identifier": "main",
  "description": "Allow the local Bilikara backend page to use fullscreen and native export save APIs.",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "http://127.0.0.1:*/*",
      "http://localhost:*/*",
      "http://*:*/*"
    ]
  },
  "permissions": [
    "core:default",
    "core:window:allow-set-fullscreen"
  ]
}
