{
  "$schema": "../gen/schemas/remote-schema.json",
  "identifier": "main",
  "description": "Allow the local Bilikara backend page to use native exports and control the host and stage windows.",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "http://127.0.0.1:*/*",
      "http://localhost:*/*",
      "http://*:*/*"
    ]
  },
  "permissions": [
    "core:default",
    "core:window:allow-set-fullscreen",
    "clipboard-manager:allow-write-text",
    "allow-save-backend-download",
    "allow-set-window-fullscreen",
    "allow-get-stage-display-info",
    "allow-open-stage-window",
    "allow-close-stage-window"
  ]
}
