{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "bilikara",
  "version": "0.6.0",
  "identifier": "com.bilikara.app",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devUrl": "http://127.0.0.1:8080",
    "frontendDist": "../static"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "fullscreen": false,
        "height": 768,
        "resizable": true,
        "title": "bilikara",
        "width": 1024,
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        "main"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
