{
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devPath": "http://127.0.0.1:8080",
    "distDir": "../static",
    "withGlobalTauri": true
  },
  "package": {
    "productName": "bilikara",
    "version": "0.6.0"
  },
  "tauri": {
    "allowlist": {
      "all": true
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "com.bilikara.app"
    },
    "security": {
      "csp": null,
      "dangerousRemoteDomainIpcAccess": [
        {
          "domain": "127.0.0.1",
          "windows": ["main"],
          "enableTauriAPI": true
        },
        {
          "domain": "localhost",
          "windows": ["main"],
          "enableTauriAPI": true
        }
      ]
    },
    "windows": [
      {
        "fullscreen": false,
        "height": 768,
        "resizable": true,
        "title": "bilikara",
        "width": 1024,
        "visible": false
      }
    ]
  }
}