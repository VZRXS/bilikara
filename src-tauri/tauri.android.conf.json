{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "bilikara Android Alpha",
  "build": {
    "devUrl": null
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "bilikara Android Alpha",
        "url": "android-alpha.html",
        "visible": true
      }
    ],
    "security": {
      "capabilities": ["android-alpha"],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "android": {
      "minSdkVersion": 24,
      "debugApplicationIdSuffix": ".alpha"
    }
  }
}
