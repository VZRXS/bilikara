{
  "name": "bilikara-tauri",
  "version": "0.8.0",
  "author": "VZRXS",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build:rust": "cd rust && cargo build --release --locked && cd ../rust-runtime && cargo build --release --locked",
    "tauri": "tauri",
    "android:init": "tauri android init --ci --skip-targets-install",
    "android:dev": "tauri android dev",
    "android:build:debug": "tauri android build --debug --apk --target aarch64 --ci",
    "dev": "tauri dev",
    "dev:rust": "tauri dev",
    "build": "python build_bundle.py --desktop",
    "prepare:desktop": "python build_bundle.py --dev"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.2"
  }
}
