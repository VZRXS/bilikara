{
  "name": "bilikara-tauri",
  "version": "0.8.0",
  "author": "VZRXS",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build:rust": "cd rust && cargo build --release --locked && cd ../rust-runtime && cargo build --release --locked",
    "tauri": "tauri",
    "android:init": "tauri android init --ci --skip-targets-install",
    "android:dev": "tauri android dev",
    "android:build:debug": "tauri android build --debug --apk --target aarch64 --ci",
    "dev": "tauri dev",
    "dev:rust": "tauri dev",
    "build": "cargo run --manifest-path xtask/Cargo.toml --locked --target host-tuple -- build-desktop",
    "prepare:desktop": "cargo run --manifest-path xtask/Cargo.toml --locked --target host-tuple -- prepare-desktop",
    "test:desktop-build": "node --test tests/desktop_prepare_entry.test.mjs tests/bbdown_prepare_entry.test.mjs tests/native_package_entry.test.mjs tests/desktop_construction_contract.test.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.2"
  }
}
