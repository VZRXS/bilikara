--- a/static/app.js
+++ b/static/app.js
@@ -212,6 +212,8 @@ const state = {
   updatePreviewEnabled: false,
   ratingPromptElement: null,
   ratingPromptItem: null,
+  ratingPromptItems: null,
+  ratingPromptActiveTab: "current",
   ratingPromptItemId: "",
   ratingPromptBvid: "",
